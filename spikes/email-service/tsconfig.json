{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Bundled by wrangler (esbuild); runtime types come from worker-configuration.d.ts (`wrangler types`).
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2024"],
		"types": ["@cloudflare/vitest-plugin/types"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
