{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
						"timeout": 600
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(pnpm plan:*)",
			"Bash(pnpm verify)",
			"Bash(pnpm lint:*)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm test:*)",
			"Bash(pnpm licenses:check)"
		]
	}
}
