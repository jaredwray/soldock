// The dock Worker: the whole backend, served from one origin.
// The top level is production. `env.development` is the development Worker at work.soldock.org, which
// deploy-development.yaml deploys on each push to main. The dock Worker has no other
// deployment environments. test/config.test.ts checks that both declare the same bindings.
// After editing bindings, run `pnpm --filter @asterra/dock types` and commit worker-configuration.d.ts.
// Use whole-line comments only: test/config.test.ts strips them to parse this file as JSON.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "soldock-dock",
	"main": "src/index.ts",
	// Pinned. Bump deliberately, in its own PR, after reading the compatibility-flag changelog.
	"compatibility_date": "2026-10-01",
	// enable_request_signal: request.signal aborts when the client disconnects. A subscriptions/listen stream
	// of /mcp then ends at once and closes its watch sockets.
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	// Production serves only its custom domain, never a second origin on workers.dev.
	"workers_dev": false,
	// Preview URLs are also workers.dev origins, with the same bindings. Each env inherits this value.
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"assets": {
		// The apps/web build. Run `pnpm build` at the repository root before dev, tests or deploy.
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Browser navigations go straight to assets, so every Worker-owned prefix must be listed here.
		// Keep in sync with WORKER_PREFIXES in src/routes.ts; a test enforces it.
		"run_worker_first": [
			"/healthz*",
			"/api/*",
			"/mcp*",
			"/oauth/*",
			"/.well-known/*",
			"/auth/*",
			"/ws/*",
			"/blob/*",
			"/dl/*",
			"/hooks/*"
		]
	},
	// Resource IDs are left out on purpose: `wrangler deploy` provisions the D1 database, the R2 bucket and
	// the queues by name on the first deploy, and finds them by name after that.
	// The directory: principals, addresses, API keys and sessions, and the room index of Chat.
	// Migrations are in ./migrations.
	"d1_databases": [{ "binding": "DIRECTORY", "database_name": "soldock-directory", "migrations_dir": "migrations" }],
	// Raw MIME of each message (key mail/raw/<mailbox id>/<sha256>), the bytes of each version of
	// each Drive file (key drive/<space id>/<item id>/<version id>, its small picture with .thumb-<id>), the
	// bytes of each image of each doc (key document/<item id>/<image id>), and the picture of each link
	// preview of Chat (key chat/<room id>/<message id>/link-<id>).
	"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "soldock-blobs" }],
	// email() puts each accepted message on soldock-mail-inbound. The consumer parses and delivers it.
	// A MailboxDO puts each webhook event on soldock-webhooks. The consumer makes one job for each webhook
	// and sends its POST. The consumer retries a POST by itself, so max_retries counts failures of Asterra.
	// A ChatRoomDO puts each message with links on soldock-chat-previews. The consumer fetches the previews.
	// The room sends a job again when no result came, so the queue needs no dead letter queue. At most 2
	// consumers run at one time, so link previews use a bounded part of the outbound capacity.
	"queues": {
		"producers": [
			{ "binding": "MAIL_INBOUND", "queue": "soldock-mail-inbound" },
			{ "binding": "MAIL_INBOUND_DLQ", "queue": "soldock-mail-inbound-dlq" },
			{ "binding": "WEBHOOKS", "queue": "soldock-webhooks" },
			{ "binding": "WEBHOOKS_DLQ", "queue": "soldock-webhooks-dlq" },
			{ "binding": "CHAT_PREVIEWS", "queue": "soldock-chat-previews" }
		],
		"consumers": [
			{
				"queue": "soldock-mail-inbound",
				"max_batch_size": 10,
				"max_batch_timeout": 2,
				"max_retries": 5,
				"dead_letter_queue": "soldock-mail-inbound-dlq"
			},
			{
				"queue": "soldock-webhooks",
				"max_batch_size": 10,
				"max_batch_timeout": 2,
				"max_retries": 10,
				"dead_letter_queue": "soldock-webhooks-dlq"
			},
			{
				"queue": "soldock-chat-previews",
				"max_batch_size": 5,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"max_concurrency": 2
			}
		]
	},
	// Outbound mail to the internet through Cloudflare Email Service. The code sets From to the
	// sender's own address, so the binding has no address list.
	"send_email": [{ "name": "EMAIL" }],
	// One MailboxDO for each principal and each team mailbox (messages, threads, labels, search index, outbox).
	// One DriveSpaceDO for each principal (items, versions, grants, trash, search index, stars, outbox).
	// One DocumentDO for each doc and each sheet (the content, its revision, and the images of a doc).
	// One ChatRoomDO for each room and each direct message of Chat (the members and the messages).
	// One ChatSearchDO for the organization: the search index of Chat (the plain text and the filter values of
	// each message). Its name has a shard key, so a later change can add more.
	"durable_objects": {
		"bindings": [
			{ "name": "MAILBOX", "class_name": "MailboxDO" },
			{ "name": "DRIVE_SPACE", "class_name": "DriveSpaceDO" },
			{ "name": "DOCUMENT", "class_name": "DocumentDO" },
			{ "name": "CHAT_ROOM", "class_name": "ChatRoomDO" },
			{ "name": "CHAT_SEARCH", "class_name": "ChatSearchDO" },
			{ "name": "PRINCIPAL", "class_name": "PrincipalDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MailboxDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["DriveSpaceDO", "DocumentDO"] },
		{ "tag": "v3", "new_sqlite_classes": ["ChatRoomDO"] },
		{ "tag": "v4", "new_sqlite_classes": ["PrincipalDO"] },
		{ "tag": "v5", "new_sqlite_classes": ["ChatSearchDO"] }
	],
	"vars": {
		// The mail domains of this deployment. Addresses on them are local. Comma-separated.
		// The receiving server whose Authentication-Results header the mailbox trusts.
		"MAIL_AUTHSERV_ID": "mx.cloudflare.net"
	},
	"env": {
		// A named env inherits `main`, the compatibility settings, observability, `assets`, routes and
		// Durable Object migrations. It does not inherit bindings or vars: when production gets a binding,
		// add the development one here.
		"development": {
			"name": "soldock-dock-dev",
			// The development host is the custom domain work.soldock.org, in the soldock.org zone of the
			// development account. It is the only origin: workers.dev is off. The deploy attaches the domain
			// and makes its DNS record. Do not give work.soldock.org another DNS record.
			"workers_dev": false,
			"routes": [{ "pattern": "work.soldock.org", "custom_domain": true }],
			"d1_databases": [
				{ "binding": "DIRECTORY", "database_name": "soldock-directory", "migrations_dir": "migrations" }
			],
			"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "soldock-blobs" }],
			"queues": {
				"producers": [
					{ "binding": "MAIL_INBOUND", "queue": "soldock-mail-inbound" },
					{ "binding": "MAIL_INBOUND_DLQ", "queue": "soldock-mail-inbound-dlq" },
					{ "binding": "WEBHOOKS", "queue": "soldock-webhooks" },
					{ "binding": "WEBHOOKS_DLQ", "queue": "soldock-webhooks-dlq" },
					{ "binding": "CHAT_PREVIEWS", "queue": "soldock-chat-previews" }
				],
				"consumers": [
					{
						"queue": "soldock-mail-inbound",
						"max_batch_size": 10,
						"max_batch_timeout": 2,
						"max_retries": 5,
						"dead_letter_queue": "soldock-mail-inbound-dlq"
					},
					{
						"queue": "soldock-webhooks",
						"max_batch_size": 10,
						"max_batch_timeout": 2,
						"max_retries": 10,
						"dead_letter_queue": "soldock-webhooks-dlq"
					},
					{
						"queue": "soldock-chat-previews",
						"max_batch_size": 5,
						"max_batch_timeout": 1,
						"max_retries": 3,
						"max_concurrency": 2
					}
				]
			},
			"send_email": [{ "name": "EMAIL" }],
			"durable_objects": {
				"bindings": [
					{ "name": "MAILBOX", "class_name": "MailboxDO" },
					{ "name": "DRIVE_SPACE", "class_name": "DriveSpaceDO" },
					{ "name": "DOCUMENT", "class_name": "DocumentDO" },
					{ "name": "CHAT_ROOM", "class_name": "ChatRoomDO" },
					{ "name": "CHAT_SEARCH", "class_name": "ChatSearchDO" },
					{ "name": "PRINCIPAL", "class_name": "PrincipalDO" }
				]
			},
			"vars": {
				"MAIL_AUTHSERV_ID": "mx.cloudflare.net"
			}
		}
	}
}
