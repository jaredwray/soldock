{
	"name": "soldock",
	"version": "0.0.0",
	"private": true,
	"description": "Open-source Google Workspace alternative (Mail, Meet, Drive, Docs, Sheets, Slides) that runs entirely on Cloudflare, for humans and AI agents alike.",
	"license": "MIT",
	"author": "Jared Wray <me@jaredwray.com>",
	"homepage": "https://soldock.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredwray/soldock.git"
	},
	"type": "module",
	"packageManager": "pnpm@11.28.5",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"plan": "node tools/plan/src/cli.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -p tsconfig.json && pnpm --recursive --if-present typecheck",
		"types:check": "pnpm --filter @soldock/dock types:check",
		"test": "vitest run",
		"test:watch": "vitest",
		"budgets:check": "node tools/budgets/check.ts apps/dock",
		"licenses:check": "node tools/licenses/check.ts",
		"workflows:check": "node tools/workflows/check.ts",
		"verify": "pnpm lint && pnpm types:check && pnpm typecheck && pnpm test && pnpm budgets:check && pnpm plan check && pnpm licenses:check && pnpm workflows:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
