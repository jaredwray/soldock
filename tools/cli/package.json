	"description": "Install and upgrade Asterra, the open-source workspace on Cloudflare, in your own Cloudflare account.",
	"license": "MIT",
	"homepage": "https://github.com/jaredwray/soldock/tree/main/tools/cli#readme",
	"repository": {
		"type": "git",
